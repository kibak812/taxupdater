# ntfy 알림 설정 예시
# 이 파일을 .env로 복사하고 실제 값을 입력하세요

# ntfy Configuration
# ntfy 앱 또는 웹에서 구독할 토픽 이름입니다.
NTFY_TOPIC=taxupdater_alerts

# 기본값은 https://ntfy.sh 입니다. 자체 서버를 쓰면 바꿔주세요.
NTFY_SERVER_URL=https://ntfy.sh

# 토픽이 보호되어 있으면 토큰 또는 사용자/비밀번호를 설정하세요.
# NTFY_TOKEN=tk_your_access_token
# NTFY_USERNAME=your_username
# NTFY_PASSWORD=your_password

# 알림에 표시할 신규 사례 요약 개수
NTFY_ITEM_LIMIT=5

# 대시보드 URL (ntfy 클릭 링크로 사용)
DASHBOARD_URL=https://taxupdater-monitor.loca.lt

# ntfy 알림을 눌렀을 때 열 URL입니다. 비워두면 사이트별 데이터 화면으로 연결됩니다.
NTFY_CLICK_URL=https://taxupdater-monitor.loca.lt/dashboard

# 레거시 이메일 알림을 다시 켜야 할 때만 사용합니다.
# EMAIL_ENABLED=false
# EMAIL_PASSWORD=your_email_password_here

# 추가 환경 변수 (필요 시)
# LOG_LEVEL=INFO
# DATABASE_PATH=data/tax_data.db
